# Optional local listener settings. The server rejects non-loopback hosts.
# No API key is required for the offline golden case, whose authenticated model
# plan/candidates are loaded from SHA-256-verified, question-scoped cache files.
HOST=127.0.0.1
PORT=4399

# Optional live LLM plan + candidate synthesis (模型提出). Leave empty for the
# offline cached-model demo. To enable the server path, also set
# INSIGHTFORGE_LLM=1 in the environment; it then records llm-planner and
# llm-synthesizer tool calls. This path is
# fail-closed: missing config, network failure, or fewer than three valid drafts
# fails SYNTHESIZE; it never silently falls back to deterministic output.
# INSIGHTFORGE_LLM_API_KEY=
# INSIGHTFORGE_LLM_BASE_URL=https://api.deepseek.com/v1
# INSIGHTFORGE_LLM_MODEL=deepseek-chat
