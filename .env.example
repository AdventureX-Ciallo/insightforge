# Optional local listener settings. The server rejects non-loopback hosts.
# No API key is required for the offline golden case or allowlisted live source check.
HOST=127.0.0.1
PORT=4399

# Optional LLM candidate synthesis (模型提出). Leave empty for the offline
# deterministic demo. To enable, also set INSIGHTFORGE_LLM=1 in the environment;
# the server and CLI then record an llm-synthesizer tool call. This path is
# fail-closed: missing config, network failure, or fewer than three valid drafts
# fails SYNTHESIZE; it never silently falls back to deterministic output.
# INSIGHTFORGE_LLM_API_KEY=
# INSIGHTFORGE_LLM_BASE_URL=https://api.deepseek.com/v1
# INSIGHTFORGE_LLM_MODEL=deepseek-chat
