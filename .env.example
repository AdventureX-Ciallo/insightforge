# Optional local listener settings. The server rejects non-loopback hosts.
# No API key is required for the offline golden case, whose authenticated model
# plan/candidates are loaded from SHA-256-verified, question-scoped cache files.
HOST=127.0.0.1
PORT=4399

# UNSAFE local-development escape hatch only. The secure default requires a
# per-process request key on every state-changing HTTP request.
# INSIGHTFORGE_DISABLE_REQUEST_KEY=1

# Optional live LLM plan + candidate synthesis (模型提出). Leave empty for the
# offline cached-model demo. To enable the server path, uncomment all four
# settings below; it then records llm-planner and
# llm-synthesizer tool calls. This path is
# fail-closed: missing config, network failure, or fewer than three valid drafts
# fails SYNTHESIZE; it never silently falls back to deterministic output.
# INSIGHTFORGE_LLM=1
# INSIGHTFORGE_LLM_API_KEY=
# INSIGHTFORGE_LLM_BASE_URL=https://api.deepseek.com/v1
# INSIGHTFORGE_LLM_MODEL=deepseek-chat

# Optional outbound DNS fallback controls. Each hop defaults to enabled and is
# tried in this order: fixed HTTPS DoH -> host/system DNS -> 1.1.1.1:53.
# Values must be exactly 0 or 1; disabling all three fails closed.
# INSIGHTFORGE_DNS_DOH=1
# INSIGHTFORGE_DNS_SYSTEM=1
# INSIGHTFORGE_DNS_UDP53=1
